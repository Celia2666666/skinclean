# ─── SKINCLEAN — variables d'environnement ───
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Sans ces clés, le site fonctionne en MODE DÉMO (aucun paiement réel, aucun e-mail envoyé).

# URL publique du site (liens dans les e-mails, sitemap, données structurées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de signature des liens de routine et des bons de bienvenue (obligatoire en production)
# Générer : openssl rand -base64 32
ROUTINE_LINK_SECRET=

# Stripe — paiements (carte, Apple Pay, Google Pay via Stripe Checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — e-mails transactionnels (routine, confirmation newsletter, rappels Skin Journal, contact)
RESEND_API_KEY=
EMAIL_FROM="SKINCLEAN <hello@ton-domaine.fr>"
CONTACT_EMAIL=

# Base de données PostgreSQL (comptes, commandes, fidélité, journal — voir prisma/schema.prisma)
DATABASE_URL=

# Glow Assistant — point d'extension IA (facultatif ; sinon mode guidé)
ASSISTANT_AI_ENDPOINT=
ASSISTANT_AI_KEY=

# ─── MARKETING HUB (/hub) ───
# Mot de passe des comptes de démonstration créés au premier lancement (à changer ensuite dans « Mon compte »)
HUB_SEED_PASSWORD=
# Base SQLite locale (par défaut data/hub/marketing-hub.sqlite)
HUB_DB_FILE=
# Planificateur des publications programmées (mettre "off" pour le désactiver)
HUB_SCHEDULER=
# Le Hub fonctionne uniquement en localhost (jamais sur Vercel ni sur un domaine public)

# Marketing Copilot — IA générative (Claude). Sans clé : mode guidé.
ANTHROPIC_API_KEY=

# Publication officielle sur les réseaux (sans clé : préparation + publication manuelle déclarée)
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=
PINTEREST_TOKEN=
PINTEREST_BOARD_ID=
TIKTOK_ACCESS_TOKEN=

# Newsletters : segment Resend alimenté par le futur CRM (RESEND_API_KEY et EMAIL_FROM ci-dessus)
RESEND_SEGMENT_ID=

# SEO : Google Search Console (jeton OAuth, scope webmasters.readonly)
GSC_SITE_URL=
GSC_ACCESS_TOKEN=
